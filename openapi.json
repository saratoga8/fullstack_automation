{
  "openapi": "3.1.0",
  "info": {
    "title": "API Server",
    "summary": "Users management",
    "description": "The API part of a Full Stack project example",
    "version": "1.0.0",
    "contact": {
      "email": "saratoga8@gmail.com"
    }
  },
  "servers": [
    {
      "url": "http://localhost:8000",
      "description": "Local API server"
    }
  ],
  "paths": {
    "/user_info/{name}": {
      "get": {
        "description": "Get user info",
        "responses": {
          "200": {
            "description": "User found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/User"
                }
              }
            }
          },
          "404": {
            "description": "User not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResponseError"
                }
              }
            }
          },
          "500": {
            "description": "Unknown error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResponseError"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "description": "User name",
            "required": true,
            "allowEmptyValue": false,
            "style": "simple",
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/user/{name}": {
      "delete": {
        "description": "Delete user",
        "responses": {
          "200": {
            "description": "User deleted",
            "content": {
              "application/json": {}
            }
          },
          "404": {
            "description": "User not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResponseError"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "description": "User name",
            "required": true,
            "allowEmptyValue": false,
            "style": "simple",
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/user": {
      "get": {
        "description": "User's authentication",
        "responses": {
          "404": {
            "description": "User not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResponseError"
                }
              }
            }
          },
          "200": {
            "description": "User authenticated successfully",
            "content": {
              "application/json": {}
            }
          },
          "500": {
            "description": "Unknown error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResponseError"
                }
              }
            }
          },
          "400": {
            "description": "Invalid user credentials",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResponseError"
                }
              }
            }
          },
          "401": {
            "description": "Invalid password",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResponseError"
                }
              }
            }
          }
        },
        "security": [
          {
            "basicAuth": []
          }
        ]
      },
      "post": {
        "description": "Add a user",
        "responses": {
          "201": {
            "description": "User created",
            "content": {
              "application/json": {}
            }
          },
          "409": {
            "description": "User already exists",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResponseError"
                }
              }
            }
          },
          "500": {
            "description": "Unknown error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResponseError"
                }
              }
            }
          },
          "400": {
            "description": "Invalid user data",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResponseError"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "description": "User name",
            "required": true,
            "allowEmptyValue": false,
            "style": "simple",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/User"
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "description": "Health check",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {}
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "User": {
        "type": [
          "object"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "password": {
            "type": "string"
          },
          "first_name": {
            "type": "string"
          },
          "last_name": {
            "type": "string"
          }
        },
        "examples": [
          {
            "name": "some_user",
            "password": "123456",
            "first_name": "John",
            "last_name": "Doe"
          }
        ]
      },
      "ResponseError": {
        "type": [
          "object"
        ],
        "properties": {
          "error": {
            "type": "string"
          }
        }
      }
    },
    "securitySchemes": {
      "basicAuth": {
        "type": "http",
        "description": "Basic authorization",
        "scheme": "basic"
      }
    }
  }
}
